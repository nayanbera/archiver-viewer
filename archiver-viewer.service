[Unit]
Description=Archiver Viewer — Beamline PV Browser
After=network.target archappl.service
Wants=network.target archappl.service

[Service]
Type=simple
User=beamline
Group=beamline

# ── Adjust these two paths to match your installation ──
WorkingDirectory=/usr/local/epics/archiver-viewer
ExecStart=/home/chem_epics/anaconda3/envs/archiver-viewer/bin/python app.py

Restart=always
RestartSec=5

# Environment — edit archiver IPs/ports if they differ
Environment="PORT=8080"
Environment="ARCHIVER_MGMT_URL=http://164.54.169.92:17665"
Environment="ARCHIVER_RETRIEVAL_URL=http://164.54.169.92:17668"
Environment="CONFIG_PATH=/usr/local/epics/archiver-viewer/config/overrides.json"

# Logging goes to journald (use: journalctl -u archiver-viewer -f)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=archiver-viewer

[Install]
WantedBy=multi-user.target
